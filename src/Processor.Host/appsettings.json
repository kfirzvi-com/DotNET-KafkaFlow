{
  "Processor": {
    "Domain": "posts"
  },
  "Kafka": {
    "Brokers": ["localhost:9092"],
    "ConsumerGroupId": "posts-processor-group",
    "InputTopic": "posts-input",
    "OutputTopic": "posts-output",
    "DeadLetterTopic": "posts-dead-letter",
    "WorkersCount": 10,
    "BufferSize": 100,
    "AutoOffsetReset": "earliest",
    "StatisticsIntervalMs": 5000
  },
  "Benchmark": {
    "WorkMicros": 0
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:8200",
    "ServiceName": "kafkaflow-processor",
    "ServiceVersion": "1.0.0",
    "Environment": "development",
    "Site": "local"
  },
  "Metrics": {
    "Port": 8080
  },
  "Oracle": {
    "ConnectionString": "User Id=processor;Password=processor;Data Source=localhost:1521/FREEPDB1",
    "SettingsTable": "DATA_TYPE_SETTINGS",
    "CommandTimeoutSeconds": 15
  },
  "DataTypeSettings": {
    "Store": "oracle",
    "RefreshMinutes": 10,
    "StartupAttempts": 3,
    "StartupRetryDelaySeconds": 5,
    "HeaderName": "data-type-id"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
